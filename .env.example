# Plaid API credentials from https://dashboard.plaid.com
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_secret

# Plaid environment: sandbox, development, or production
PLAID_ENV=sandbox

# Server port
PORT=3000

# API key used to secure endpoints — send as Bearer token in Authorization header
API_KEY=your_api_key_here

# Public URL where PlaidConnect is reachable (used by Claude Code skills)
# Use localhost if on the same machine, Tailscale IP/hostname if remote
PLAIDCONNECT_URL=http://localhost:3000

# Allowed CORS origin — set to your frontend URL
CORS_ORIGIN=http://localhost:5173

# Optional: Plaid API version override (defaults to latest)
# PLAID_API_VERSION=2020-09-14
